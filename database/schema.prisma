// ============================================================================
// RHO — Schéma de base de données (PostgreSQL + Prisma)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Utilisateurs, rôles, sécurité
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  SUPPORT
  VENDEUR
  CLIENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  avatarUrl     String?
  role          Role     @default(CLIENT)

  // OAuth
  provider      String?  // "google" | "facebook" | "github" | "apple" | null (email/password)
  providerId    String?

  // Sécurité
  emailVerified Boolean  @default(false)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Préférences boutique
  usualSize     Float?
  favoriteStyle String?
  language      String   @default("fr")
  currency      String   @default("XOF")
  loyaltyPoints Int      @default(0)

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      WishlistItem[]
  reviews       Review[]
  questions     Question[]
  answers       Answer[]
  notifications Notification[]
  paymentMethods PaymentMethod[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  referralsGiven    Referral[] @relation("ReferralSponsor")
  referralReceived  Referral?  @relation("ReferralInvitee")
  comparisons   ComparisonItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

model Referral {
  id          String   @id @default(cuid())
  code        String   @unique
  sponsorId   String
  sponsor     User     @relation("ReferralSponsor", fields: [sponsorId], references: [id], onDelete: Cascade)
  inviteeId   String?  @unique
  invitee     User?    @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)
  rewardGranted Boolean @default(false)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Catalogue : produits, variantes (pointure × coloris), attributs
// ---------------------------------------------------------------------------

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductGender {
  HOMME
  FEMME
  ENFANT
  UNISEXE
}

enum ProductUsage {
  RUNNING
  STREETWEAR
  TRAINING
  VILLE
  SPORT
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  slug        String   @unique
  name        String
  description String
  materials   String?
  careInstructions String?
  gender      ProductGender @default(UNISEXE)
  usage       ProductUsage?
  drop        Float?   // drop en mm (running)
  weightGrams Int?
  soleType    String?

  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])
  categories  ProductCategory[]

  basePrice   Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)

  isNew       Boolean  @default(false)
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)

  images      ProductImage[]
  variants    Variant[]
  reviews     Review[]
  questions   Question[]
  wishlistedBy WishlistItem[]
  comparisons  ComparisonItem[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  flashSaleItems FlashSaleItem[]

  avgRating   Float?   @default(0)
  reviewCount Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([isPublished, isFeatured])
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  angle     String?  // "front" | "side" | "back" | "sole" | "360-01"..."360-24"
  isVideo   Boolean  @default(false)
  position  Int      @default(0)

  @@index([productId])
}

model Color {
  id      String    @id @default(cuid())
  name    String    @unique
  hexCode String
  variants Variant[]
}

model Size {
  id       String    @id @default(cuid())
  eu       Float     @unique // ex 42.5
  us       Float?
  uk       Float?
  variants Variant[]
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId    String
  size      Size     @relation(fields: [sizeId], references: [id])
  colorId   String
  color     Color    @relation(fields: [colorId], references: [id])

  stock       Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2)

  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sizeId, colorId])
  @@index([productId])
}

model Warehouse {
  id       String   @id @default(cuid())
  name     String
  address  String?
  movements StockMovement[]
}

model StockMovement {
  id          String    @id @default(cuid())
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantity    Int       // positif = entrée, négatif = sortie
  reason      String    // "purchase" | "sale" | "return" | "adjustment"
  createdAt   DateTime  @default(now())

  @@index([variantId])
}

model Supplier {
  id      String @id @default(cuid())
  name    String
  email   String?
  phone   String?
}

// ---------------------------------------------------------------------------
// Avis, questions/réponses
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int      // 1-5
  title      String?
  comment    String?
  verifiedPurchase Boolean @default(false)
  photos     String[]
  status     String   @default("pending") // pending | approved | rejected | reported

  createdAt  DateTime @default(now())

  @@index([productId])
}

model Question {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  answers   Answer[]
  createdAt DateTime @default(now())

  @@index([productId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Wishlist, comparateur, panier
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ComparisonItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)

  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id])
  quantity  Int      @default(1)

  @@unique([cartId, variantId])
}

// ---------------------------------------------------------------------------
// Commandes, paiements, livraison
// ---------------------------------------------------------------------------

enum OrderStatus {
  EN_ATTENTE
  PAYEE
  PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
  REMBOURSEE
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?  // "Domicile", "Bureau"...
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String
  isDefault  Boolean  @default(false)

  ordersShipping  Order[] @relation("ShippingAddress")
  ordersBilling   Order[] @relation("BillingAddress")

  createdAt  DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(EN_ATTENTE)

  items           OrderItem[]

  shippingAddressId String
  shippingAddress   Address  @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String
  billingAddress    Address  @relation("BillingAddress", fields: [billingAddressId], references: [id])

  subtotal        Decimal     @db.Decimal(10, 2)
  shippingCost    Decimal     @db.Decimal(10, 2) @default(0)
  taxAmount       Decimal     @db.Decimal(10, 2) @default(0)
  discountAmount  Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("XOF")

  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)

  payment         Payment?
  invoice         Invoice?
  shipment        Shipment?
  returns         ReturnRequest[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

enum PaymentMethodType {
  ORANGE_MONEY
  MTN_MONEY
  WAVE
  VIREMENT
  ESPECES
}

enum PaymentStatus {
  EN_ATTENTE
  VALIDE
  ECHOUE
  REMBOURSE
}

model PaymentMethod {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       PaymentMethodType
  provider   String?           // "stripe" | "flutterwave"...
  last4      String?
  externalId String?           // token/ID chez le prestataire
  isDefault  Boolean           @default(false)
  createdAt  DateTime          @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethodType
  status        PaymentStatus @default(EN_ATTENTE)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("XOF")
  transactionReference String? // référence fournie par le client (Mobile Money / virement)
  validatedById String?       // utilisateur (rôle admin/manager) qui a validé manuellement
  paidAt        DateTime?

  createdAt     DateTime      @default(now())
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  pdfUrl    String?
  issuedAt  DateTime @default(now())
}

model Shipment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  gpsLat         Float?
  gpsLng         Float?
  shippedAt      DateTime?
  deliveredAt    DateTime?
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String
  photos    String[]
  refundMethod String // "original" | "store-credit"
  status    String   @default("pending") // pending | approved | rejected | completed
  refund    Refund?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Refund {
  id       String        @id @default(cuid())
  returnId String        @unique
  return   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  amount   Decimal       @db.Decimal(10, 2)
  status   PaymentStatus @default(EN_ATTENTE)
  processedAt DateTime?
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  discountType  String   // "percentage" | "fixed"
  discountValue Decimal  @db.Decimal(10, 2)
  minOrderValue Decimal? @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int      @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean  @default(true)

  carts  Cart[]
  orders Order[]

  createdAt DateTime @default(now())
}

model FlashSale {
  id        String          @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  items     FlashSaleItem[]
  createdAt DateTime        @default(now())
}

model FlashSaleItem {
  id           String    @id @default(cuid())
  flashSaleId  String
  flashSale    FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPct  Float

  @@unique([flashSaleId, productId])
}

model GiftCard {
  id        String   @id @default(cuid())
  code      String   @unique
  balance   Decimal  @db.Decimal(10, 2)
  currency  String   @default("XOF")
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Contenu, notifications, messagerie
// ---------------------------------------------------------------------------

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  String   // "home-hero-secondary" | "category-top"...
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  comments    Comment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Comment {
  id         String   @id @default(cuid())
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  authorName String
  content    String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(IN_APP)
  type      String              // "delivery" | "promo" | "review" | "stock-alert"...
  title     String
  body      String
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
}

model Message {
  id        String   @id @default(cuid())
  senderId  String?
  content   String
  channel   String   @default("live-chat")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Paramètres globaux
// ---------------------------------------------------------------------------

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

model Tax {
  id     String  @id @default(cuid())
  region String
  rate   Float
}

model Currency {
  id     String  @id @default(cuid())
  code   String  @unique // "XOF", "EUR", "USD"
  symbol String
  rate   Float   // taux vs devise pivot
}

model Language {
  id   String @id @default(cuid())
  code String @unique // "fr", "en"
  name String
}
